"""Inspecionado conforme exemplo da documentação do desafio, no entanto, incluí o .describe() para análise estatística inicial. Pela análise de tipo de dados, vemos que a coluna de data precisa ser transformada, pois está como objeto, e a de quantidade deve ser modificada para inteiro ao invés de float. Pela verificação dos valores nulos, temos que há 29 registros nulos na coluna de quantidade, e 16 valores nulos na coluna de preço unitário. Para a coluna de quantidade e valores unitários, retirarei essas linhas, pois são valores relevantes, e, devem ser removidos de acordo com as instruções do trabalho..

4 - Limpeza e Tratamento dos dados (datetime e regex)
"""

def limpar_dados(df):

    # Limpa e trata os dados do DataFrame de vendas.

    # Cria uma cópia temporária para garantir que não será alterado o DataFrame original
    df = df.copy()

    registros_iniciais = len(df)

    # 1 - Remover espaços extras

    colunas_texto = ["cliente", "produto", "categoria", "regiao"]

    for coluna in colunas_texto:
        df[coluna] = df[coluna].str.strip()

    # 2 - Converter datas inválidas
    df["data_venda"] = pd.to_datetime(
        df["data_venda"],
        errors="coerce"
    )

    datas_invalidas = df["data_venda"].isna().sum()

    # Remove registros com data inválida
    df = df.dropna(subset=["data_venda"])

    # 3 - Remover valores nulos
    registros_antes_nulos = len(df)

    df = df.dropna(
        subset=["quantidade", "preco_unitario"]
    )

    registros_removidos_nulos = (
        registros_antes_nulos - len(df)
    )

    # 4 - Corrigir tipos de dados
    df["quantidade"] = df["quantidade"].astype(int)

    df["preco_unitario"] = df["preco_unitario"].astype(float)

    # 5 - Padronizar nomes dos clientes
    def padronizar_cliente(cliente):

        cliente = str(cliente).strip()

        # Remove caracteres especiais
        cliente = re.sub(
            r"[^A-Za-z0-9_]",
            "",
            cliente
        )

        # Procura três números no final do nome
        numeros = re.search(
            r"(\d{3})$",
            cliente
        )

        if numeros:
            return f"Cliente_{numeros.group(1)}"

        return cliente

    df["cliente"] = df["cliente"].apply(
        padronizar_cliente
    )

    # 6 - Verificar clientes fora do padrão
    padrao_cliente = re.compile(
        r"^Cliente_\d{3}$",
        flags=re.IGNORECASE
    )

    clientes_fora_padrao = (
        ~df["cliente"].str.match(padrao_cliente)
    ).sum()

    # 7 - Relatório da limpeza
    registros_finais = len(df)

    registros_removidos = (
        registros_iniciais - registros_finais
    )

    relatorio = {
        "registros_iniciais": registros_iniciais,
        "datas_invalidas": int(datas_invalidas),
        "removidos_por_nulos": int(registros_removidos_nulos),
        "registros_removidos_total": int(registros_removidos),
        "registros_finais": registros_finais,
        "clientes_fora_padrao": int(clientes_fora_padrao)
    }

    print("\n=== RELATÓRIO DE LIMPEZA ===")
    print(f"Registros iniciais: {registros_iniciais}")
    print(f"Datas inválidas: {datas_invalidas}")
    print(f"Removidos por valores nulos: {registros_removidos_nulos}")
    print(f"Registros removidos no total: {registros_removidos}")
    print(f"Registros finais: {registros_finais}")
    print(f"Clientes fora do padrão: {clientes_fora_padrao}")

    return df, relatorio


# Aplicar a função de limpeza
df_limpo, relatorio = limpar_dados(df)

